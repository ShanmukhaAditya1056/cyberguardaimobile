<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>
    <uses-permission android:name="android.permission.CHANGE_WIFI_STATE"/>
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION"/>
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION"/>
    <!-- Android 13+ (API 33) requires NEARBY_WIFI_DEVICES to read the
         connected SSID; without it WifiInfo.getSsid() returns
         "<unknown ssid>" even when ACCESS_FINE_LOCATION is granted. We do
         NOT pair this with the "neverForLocation" flag because we still
         want SSID/BSSID, which Google considers location-derivable. -->
    <uses-permission android:name="android.permission.NEARBY_WIFI_DEVICES"/>
    <uses-permission android:name="android.permission.READ_SMS"/>
    <uses-permission android:name="android.permission.RECEIVE_SMS"/>
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission"/>
    <!-- RECEIVE_BOOT_COMPLETED, FOREGROUND_SERVICE and
         FOREGROUND_SERVICE_DATA_SYNC deliberately absent. They existed only to
         keep PhishingGuardService resident and to restart it after a reboot.
         The SMS guard is now a manifest receiver (see below), which Android
         re-registers across reboots on its own, so none of the three has a
         caller left. Dropping FOREGROUND_SERVICE_DATA_SYNC also removes a
         service-type declaration that never honestly described SMS scanning —
         something Android 14+ and Play review are strict about. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <!-- WAKE_LOCK deliberately absent. Nothing acquires one: there is no
         PowerManager use anywhere in the Kotlin sources, no plugin declares
         it, and NotificationService only ever calls show() — there are no
         zonedSchedule/exact-alarm paths that would need the CPU held awake.
         Incoming SMS already arrive with their own broadcast wakelock. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32"/>

    <application
        android:label="CyberGuard AI"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:usesCleartextTraffic="false"
        android:networkSecurityConfig="@xml/network_security_config">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">

            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/NormalTheme"/>

            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Smart Link Interceptor: register as a handler for tapped web
                 links so CyberGuard appears in the "Open with" chooser and can
                 vet a URL before a browser loads it. We deliberately do NOT set
                 autoVerify/default — the user opts in by choosing CyberGuard,
                 keeping behaviour transparent and policy-compliant. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="http"/>
                <data android:scheme="https"/>
            </intent-filter>

            <!-- Accept links shared from WhatsApp / Telegram / Gmail etc. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <data android:mimeType="text/plain"/>
            </intent-filter>
        </activity>

        <meta-data
            android:name="flutterEmbedding"
            android:value="2"/>

        <!-- flutter_local_notifications does NOT declare this in its own
             manifest, and action buttons whose showsUserInterface is false
             (our "Dismiss") are delivered here via PendingIntent.getBroadcast.
             Without this declaration the broadcast targets a component that
             doesn't exist, so tapping the button does nothing at all. -->
        <receiver
            android:name="com.dexterous.flutterlocalnotifications.ActionBroadcastReceiver"
            android:exported="false"/>

        <!-- Background SMS phishing guard.
             SMS_RECEIVED is on the implicit-broadcast allowlist, so this is
             delivered to even when nothing of the app is running — Android
             starts the process for it. That is why there is no longer a
             resident foreground service (nor a BootReceiver to restart one):
             a manifest receiver survives reboots by itself.
             Scanning is native Kotlin in SmsGuard — no Dart runtime needed —
             and no-ops unless the user turned the guard on.
             MUST NOT also be registered dynamically: both would fire and every
             message would be scanned twice. -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:enabled="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED"/>
            </intent-filter>
        </receiver>
    </application>
</manifest>
