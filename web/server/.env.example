# Copy to web/server/.env and fill in. Never commit the real file.

# --- Required in production -------------------------------------------------

# Signs session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to start in production without it rather than falling back
# to a default that is published in this repository.
JWT_SECRET=

# --- Connection -------------------------------------------------------------

MONGO_URI=mongodb://127.0.0.1:27017/cyberguard
PORT=4000
NODE_ENV=development

# Origins allowed to send the session cookie. Comma-separated, no wildcards —
# `credentials: true` makes a wildcard illegal. Add your deployed client origin.
CORS_ORIGINS=http://localhost:5173

# --- Optional ---------------------------------------------------------------

# Without a key the Breach Monitor still works: password checks use the free
# k-anonymity range API, and account lookups fall back to the offline dataset
# (clearly labelled in the UI). A key unlocks the real account lookup.
# Get one at https://haveibeenpwned.com/API/Key
HIBP_API_KEY=

HIBP_USER_AGENT=CyberGuard-AI-Web

# How long a session lasts. Accepts anything the `ms` package parses.
JWT_EXPIRES_IN=7d

# --- Shared login with the Android app ----------------------------------------
#
# Set this to the Firebase project the app authenticates against — the
# `project_id` in android/app/google-services.json — and an account created on
# the phone signs in here, and vice versa. The browser runs the Firebase JS SDK
# and posts its ID token to /api/auth/session, which verifies it and issues the
# usual httpOnly session cookie.
#
# Leave it blank and nothing breaks: /api/auth/session reports itself
# unconfigured and the local email/password accounts below remain the way in.
# That is the state CI runs in, which is why the test suites need no
# credentials.
FIREBASE_PROJECT_ID=

# Optional. Verifying an ID token needs only the project ID above, because the
# signing keys are Google's public certificates. Set this only if you later add
# an admin operation that needs privileged access. Accepts a path to the
# service-account JSON, or the JSON itself for hosts that only offer env vars.
# It is a real secret — never commit it.
FIREBASE_SERVICE_ACCOUNT=
